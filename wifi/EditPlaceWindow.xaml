<Window x:Class="wifi.EditPlaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать место" Height="400" Width="435" MinHeight = "400" MaxHeight = "400" MinWidth = "435" MaxWidth = "435"
        WindowStartupLocation="CenterScreen"
        Background="#FF163832" ResizeMode="NoResize"
        >
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Название:" Foreground="White"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10" MaxLength="25" TextWrapping="Wrap"/>

            <TextBlock Text="Тип:" Foreground="White"/>
            <ComboBox x:Name="TypeBox" Margin="0,0,0,10">
                <ComboBoxItem Content="Кафе"/>
                <ComboBoxItem Content="Библиотека"/>
                <ComboBoxItem Content="Лаунж-зона"/>
            </ComboBox>

            <TextBlock Text="Адрес:" Foreground="White"/>
            <TextBox x:Name="AddressBox" Margin="0,0,0,10" MaxLength="30" TextWrapping="Wrap"/>

            <TextBlock Text="Качество Wi-Fi:" Foreground="White"/>
            <ComboBox x:Name="WiFiBox" Margin="0,0,0,10">
                <ComboBoxItem Content="Плохо"/>
                <ComboBoxItem Content="Средне"/>
                <ComboBoxItem Content="Хорошо"/>
                <ComboBoxItem Content="Отлично"/>
            </ComboBox>

            <TextBlock Text="Часы работы:" Foreground="White"/>
            <ComboBox x:Name="WorkBox" Margin="0,0,0,8">
                <ComboBoxItem Content="Круглосуточно"/>
                <ComboBoxItem Content="06:00-23:00"/>
                <ComboBoxItem Content="07:00-22:00"/>
                <ComboBoxItem Content="08:00-21:00"/>
                <ComboBoxItem Content="09:00-20:00"/>
                <ComboBoxItem Content="10:00-19:00"/>
            </ComboBox>
           
            <TextBlock Text="Контакт:" Foreground="White"/>
            <TextBox x:Name="ContactBox" Margin="0,0,0,10" MaxLength="11" TextWrapping="Wrap" TextChanged="ContactBox_TextChanged"/>

           

            <Button Content="Сохранить" Click="Save_Click" Background="#FF8EB69B"/>
        </StackPanel>
    </ScrollViewer>
</Window>
